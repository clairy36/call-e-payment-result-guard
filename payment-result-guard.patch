+  expect(mocks.insert).not.toHaveBeenCalled();
+});
+
+test('unavailable interpreter is reviewable and persists sanitized source', async () => {
+  const old = process.env.PAYMENT_GUARD_PYTHON;
+  process.env.PAYMENT_GUARD_PYTHON='/missing/python';
+  try {
+    await POST(req());
+    expect(mocks.complete.mock.calls[0][1]).toMatchObject({decision:'unknown',recovered_cents:0});
+    expect(mocks.complete.mock.calls[0][1].action_taken).toContain('VALIDATOR_UNAVAILABLE');
+    expect(mocks.complete.mock.calls[0][1].raw_result).toBeTruthy();
+  } finally {process.env.PAYMENT_GUARD_PYTHON=old;}
+});
+
+test('card-update does not emit a fake billing URL', async () => {
+  const call = structuredClone(fixtures.retry.call); call.structuredResult.decision='update_card';
+  mocks.fetch.mockResolvedValue(call); await POST(req());
+  expect(mocks.complete.mock.calls[0][1].action_link).toBeNull();
