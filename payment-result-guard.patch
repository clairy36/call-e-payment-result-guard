diff --git a/apps/typescript/recover/tests/result-guard.test.ts b/apps/typescript/recover/tests/result-guard.test.ts
new file mode 100644
index 0000000..5625aa4
--- /dev/null
+++ b/apps/typescript/recover/tests/result-guard.test.ts
@@ -0,0 +1,65 @@
+import { expect, test } from 'vitest';
+import { evaluateRecoveryCall, runGuard, recoveryEnvelope } from '../lib/result-guard';
+import fixtures from './fixtures/recovery.json';
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+const sample = () => structuredClone(fixtures.retry);
+
+test('shared Python process returns advisory, never recovered', async () => {
+  const f = sample();
+  const out = await evaluateRecoveryCall(f.call, f.subscriber, f.callLog);
+  expect(out.claim_status).toBe('supported');
+  expect(out.business_effect_status).toBe('advisory_only');
+  expect(out.execution_authorized).toBe(false);
+});
+
+test.each(['missing', 'unknown', 'negative', 'paraphrase', 'multi_attempt', 'metadata', 'phone'])('%s cannot recommend retry', async kind => {
+  const f = sample();
+  const attempt = f.call.recipients[0].attempts[0];
+  if (kind === 'missing') attempt.transcriptTurns = [];
+  if (kind === 'unknown') attempt.transcriptTurns[0].speaker = 'unknown';
+  if (kind === 'negative') attempt.transcriptTurns[0].text = f.call.structuredResult.evidence = 'Do not retry my payment.';
+  if (kind === 'paraphrase') f.call.structuredResult.evidence = 'The customer agreed.';
+  if (kind === 'multi_attempt') f.call.recipients[0].attempts.push(structuredClone(attempt));
+  if (kind === 'metadata') f.call.metadata.subscriberId = 'another';
+  if (kind === 'phone') f.call.recipients[0].phones = [];
+  expect((await evaluateRecoveryCall(f.call, f.subscriber, f.callLog)).claim_status).not.toBe('supported');
+});
+
+test('bridge fails closed if interpreter is absent', async () => {
+  expect((await runGuard({}, { python: '/nonexistent/guard-python' })).reason_codes).toEqual(['VALIDATOR_UNAVAILABLE']);
+});
+
+test.each(['bad_json','timeout','overflow','exit','wrong_contract'])('bridge rejects %s without leaking output', async mode => {
+  const dir = mkdtempSync(join(tmpdir(), 'guard-'));
+  const executable = join(dir, 'fake-python');
+  const body = mode === 'timeout' ? 'sleep 1' : mode === 'overflow' ? "head -c 300000 /dev/zero" : mode === 'exit' ? 'exit 1' : mode === 'wrong_contract' ? `printf '%s' '{"claim_status":"supported","execution_authorized":true}'` : "printf 'private-not-json'";
+  writeFileSync(executable, '#!/bin/sh\n' + body + '\n', { mode: 0o700 });
+  try {
+    const f = sample();
+    const result = await runGuard(recoveryEnvelope(f.call, f.subscriber, f.callLog), { python: executable, timeoutMs: 100 });
+    expect(result.reason_codes).toEqual(['VALIDATOR_UNAVAILABLE']);
+    expect(JSON.stringify(result)).not.toContain('private-not-json');
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+import { readFileSync } from 'node:fs';
+const corpus: Record<string, {input: {source:{scope:string;binding:string};context:{locale:string};claims:Record<string,unknown>;turns:Array<{speaker:string;text:string}>};expected:{claim_status:string;business_effect_status:string;reason:string|null}}> = JSON.parse(readFileSync(new URL('../../../python/payment-result-guard/fixtures/cases.json', import.meta.url), 'utf8'));
+test.each(Object.entries(corpus).filter(([name])=>name.startsWith('recover_')))('actual Recover adapter replay: %s', async (_name, c) => {
+  const f = sample();
+  const call = {...f.call, structuredResult:c.input.claims};
+  f.subscriber.locale = c.input.context.locale;
+  call.recipients[0].attempts[0].transcriptTurns = c.input.turns.map((t,i)=>({...t,offset_seconds:i}));
+  if(c.input.source.scope !== 'single_attempt') call.recipients[0].attempts.push(structuredClone(call.recipients[0].attempts[0]));
+  if(c.input.source.binding !== 'matched') call.metadata.subscriberId='wrong';
+  const out=await evaluateRecoveryCall(call,f.subscriber,f.callLog);
+  expect(out.claim_status).toBe(c.expected.claim_status);
+  expect(out.business_effect_status).toBe(c.expected.business_effect_status);
+  if(c.expected.reason) expect(out.reason_codes).toContain(c.expected.reason);
+});
+
+test.each([undefined, '+12025550199'])('unbound attempt phone %s cannot recommend retry', async phone => {
+  const f=sample(); Object.assign(f.call.recipients[0].attempts[0], {phone});
+  expect((await evaluateRecoveryCall(f.call,f.subscriber,f.callLog)).claim_status).not.toBe('supported');
+});
