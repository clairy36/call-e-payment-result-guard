+def _evidence_scope(call: dict[str, Any]) -> str:
+    recipients = call.get("recipients") or []
+    if len(recipients) != 1:
+        return "ambiguous"
+    attempts = recipients[0].get("attempts") or []
+    if len(attempts) != 1 or attempts[0].get("status") != "completed":
+        return "ambiguous"
+    phones = recipients[0].get("phones") or []
