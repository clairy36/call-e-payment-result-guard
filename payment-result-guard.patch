diff --git a/apps/typescript/recover/lib/result-guard.ts b/apps/typescript/recover/lib/result-guard.ts
new file mode 100644
index 0000000..0b90d33
--- /dev/null
+++ b/apps/typescript/recover/lib/result-guard.ts
@@ -0,0 +1,122 @@
+/** Local Node-only adapter. No calls, payments, shell interpolation or HTTP service. */
+import { spawn } from 'node:child_process';
+
+type RecordValue = Record<string, unknown>;
+export interface GuardDecision {
+  schema_version: '0.1';
+  claim_status: 'supported' | 'conditional' | 'contradicted' | 'needs_review' | 'unsupported';
+  business_effect_status: 'recordable' | 'advisory_only' | 'pending_external_verification' | 'review_required';
+  normalized_claim: { kind: string };
+  reason_codes: string[];
+  evidence_refs: string[];
+  next_step: string;
+  execution_authorized: false;
+  data_origin: string;
+}
+const record = (v: unknown): RecordValue => v !== null && typeof v === 'object' && !Array.isArray(v) ? v as RecordValue : {};
+const list = (v: unknown): unknown[] => Array.isArray(v) ? v : [];
+const codes = new Set(['INVALID_INPUT','MISSING_EVIDENCE','QUOTE_NOT_FOUND','WRONG_SPEAKER','AMBIGUOUS_SOURCE','OBJECT_MISMATCH','CONDITIONAL_STATEMENT','CONTRADICTORY_EVIDENCE','AMBIGUOUS_AMOUNT','UNSUPPORTED_EXPRESSION','PAYMENT_SUCCESS_NOT_VERIFIED','VALIDATOR_UNAVAILABLE']);
+
+export function unavailable(reason = 'VALIDATOR_UNAVAILABLE'): GuardDecision {
+  return { schema_version:'0.1', claim_status:'needs_review', business_effect_status:'review_required',
+    normalized_claim:{kind:'unknown'}, reason_codes:[reason], evidence_refs:[], next_step:'operator_review',
+    execution_authorized:false, data_origin:'host_result' };
+}
+
+export function recoveryEnvelope(callInput: unknown, subscriberInput: unknown, logInput: unknown) {
+  const call = record(callInput), subscriber = record(subscriberInput), log = record(logInput);
+  const recipients = list(call.recipients), recipient = record(recipients[0]);
+  const attempts = list(recipient.attempts), attempt = record(attempts[0]);
+  const phones = list(recipient.phones), metadata = record(call.metadata);
+  const bound = typeof call.id === 'string' && call.id.length > 0 && call.id === log.calle_call_id &&
+    typeof subscriber.id === 'string' && subscriber.id.length > 0 && subscriber.id === log.subscriber_id &&
+    metadata.subscriberId === subscriber.id && typeof subscriber.phone === 'string' && subscriber.phone.length > 0 &&
+    phones.length === 1 && phones[0] === subscriber.phone && attempt.phone === subscriber.phone;
+  const complete = call.status === 'completed' && call.taskCompleted === true;
+  const scoped = recipients.length === 1 && attempts.length === 1 && attempt.status === 'completed';
+  const top = record(call.structuredResult);
+  const claims = Object.keys(top).length ? top : record(recipient.structuredResult);
+  return { schema_version:'0.1', scenario:'payment_recovery',
+    context:{object_id:subscriber.id, currency:'USD', amount_minor:subscriber.amount_cents, locale:subscriber.locale},
+    source:{call_id:call.id, binding:bound ? 'matched' : 'mismatch',
+      scope:complete && scoped ? 'single_attempt' : 'ambiguous', data_origin:'host_result'},
+    claims,
+    turns:list(attempt.transcriptTurns).map((value, i) => {
+      const turn = record(value);
+      return {id:`r0:a0:t${i}`, speaker:turn.speaker, text:turn.text};
+    }),
+  };
+}
+
+/** No-answer is a provider outcome, not an inference from missing evidence. */
+export function isBoundNoAnswer(callInput: unknown, subscriberInput: unknown, logInput: unknown): boolean {
+  const call=record(callInput), recipient=record(list(call.recipients)[0]);
+  const attempts=list(recipient.attempts), attempt=record(attempts[0]);
+  const envelope=recoveryEnvelope(callInput, subscriberInput, logInput);
+  return envelope.source.binding === 'matched' && list(call.recipients).length === 1 &&
+    attempts.length === 1 && ['completed','failed'].includes(String(call.status)) &&
+    ['completed','failed'].includes(String(attempt.status)) &&
+    envelope.claims.decision === 'no_answer' && envelope.claims.evidence === '' &&
+    Array.isArray(attempt.transcriptTurns) && attempt.transcriptTurns.every(value => {
+      const turn=record(value);
+      return turn.speaker === 'bot' && typeof turn.text === 'string';
+    });
+}
+
+function validDecision(value: unknown): value is GuardDecision {
+  const d = record(value), claim = record(d.normalized_claim);
+  const valid = d.schema_version === '0.1' && d.execution_authorized === false &&
+    ['supported','conditional','contradicted','needs_review','unsupported'].includes(String(d.claim_status)) &&
+    ['recordable','advisory_only','pending_external_verification','review_required'].includes(String(d.business_effect_status)) &&
+    typeof claim.kind === 'string' && typeof d.data_origin === 'string' && d.next_step === 'operator_review' &&
+    Array.isArray(d.reason_codes) && d.reason_codes.every(code => typeof code === 'string' && codes.has(code)) &&
+    Array.isArray(d.evidence_refs) && d.evidence_refs.every(ref => typeof ref === 'string');
+  if (!valid) return false;
+  if (d.claim_status === 'supported') {
+    return (d.business_effect_status === 'advisory_only' && claim.kind === 'retry_requested') ||
+      (d.business_effect_status === 'pending_external_verification' && claim.kind === 'reported_paid');
+  }
+  return d.business_effect_status === 'review_required';
+}
+
+export async function runGuard(input: unknown, options: {python?: string; timeoutMs?: number} = {}): Promise<GuardDecision> {
+  let payload: string;
+  try { payload = JSON.stringify(input); } catch { return unavailable('INVALID_INPUT'); }
+  if (!payload || Buffer.byteLength(payload) > 262144) return unavailable('INVALID_INPUT');
+  return new Promise(resolve => {
+    let done = false, stdout = '', bytes = 0;
+    const child = spawn(options.python ?? process.env.PAYMENT_GUARD_PYTHON ?? 'python3', ['-m','payment_result_guard'],
+      {shell:false, stdio:['pipe','pipe','pipe']});
+    const finish = (out: GuardDecision) => {
+      if (done) return;
+      done = true;
+      clearTimeout(timer);
+      child.kill();
+      resolve(out);
+    };
+    const timer = setTimeout(() => finish(unavailable()), options.timeoutMs ?? 5000);
+    child.on('error', () => finish(unavailable()));
+    child.stdin.on('error', () => finish(unavailable()));
+    child.stdout.on('data', (chunk: Buffer) => {
+      bytes += chunk.length;
+      if (bytes > 262144) return finish(unavailable());
+      stdout += chunk.toString('utf8');
+    });
+    child.stderr.on('data', (chunk: Buffer) => {
+      bytes += chunk.length;
+      if (bytes > 262144) finish(unavailable());
+    });
+    child.on('close', code => {
+      if (code !== 0) return finish(unavailable());
+      try {
+        const parsed: unknown = JSON.parse(stdout);
+        finish(validDecision(parsed) ? parsed : unavailable());
+      } catch { finish(unavailable()); }
+    });
+    child.stdin.end(payload);
+  });
+}
+
+export function evaluateRecoveryCall(call: unknown, subscriber: unknown, log: unknown): Promise<GuardDecision> {
+  return runGuard(recoveryEnvelope(call, subscriber, log));
+}
