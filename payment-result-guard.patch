+test('unbound no-answer result never schedules another call', async () => {
+  const call = structuredClone(fixtures.retry.call);
+  call.structuredResult={decision:'no_answer',evidence:''};
+  call.metadata.subscriberId='other'; call.recipients[0].attempts[0].transcriptTurns=[];
+  mocks.fetch.mockResolvedValue(call); await POST(req());
