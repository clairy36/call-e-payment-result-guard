+
+test('a bound no-answer result retains the existing bounded follow-up', async () => {
+  const call = structuredClone(fixtures.retry.call);
+  call.structuredResult={decision:'no_answer',evidence:''};
+  call.recipients[0].attempts[0].transcriptTurns=[];
