+vi.mock('@/lib/calle', () => ({fetchVerifiedCalleCall:mocks.fetch,MAX_CALL_ATTEMPTS:3,followUpDelayMinutes:()=>1440}));
+vi.mock('@/lib/auth', () => ({validateWebhookAuth:mocks.auth}));
+import { POST } from '../app/api/calle/webhook/route';
+function req() {return new NextRequest('http://localhost/api/calle/webhook', {method:'POST',body:JSON.stringify({id:'event_demo',data:{id:'call_demo'}})});}
+beforeEach(() => {
+  vi.resetAllMocks();
+  const f = structuredClone(fixtures.retry);
+  mocks.auth.mockReturnValue(true); mocks.has.mockReturnValue(false);
+  mocks.fetch.mockResolvedValue(f.call); mocks.getLog.mockReturnValue(f.callLog);
+  mocks.subscriber.mockReturnValue({...f.subscriber,followups_paused:0}); mocks.count.mockReturnValue(1);
+});
