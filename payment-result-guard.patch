+});
+
+test.each(['attempts_missing', 'turns_missing', 'malformed_evidence', 'attempt_phone', 'attempt_pending'])('invalid no-answer %s cannot schedule follow-up', async kind => {
+  const call = structuredClone(fixtures.retry.call);
+  call.structuredResult={decision:'no_answer',evidence:''};
+  call.recipients[0].attempts[0].transcriptTurns=[];
+  if (kind === 'attempts_missing') Reflect.deleteProperty(call.recipients[0], 'attempts');
+  if (kind === 'turns_missing') Reflect.deleteProperty(call.recipients[0].attempts[0], 'transcriptTurns');
+  if (kind === 'malformed_evidence') Object.assign(call.structuredResult, {evidence:42});
+  if (kind === 'attempt_phone') Object.assign(call.recipients[0].attempts[0], {phone:'+12025550199'});
