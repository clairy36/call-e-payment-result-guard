+"""Thin mapping after the host has checked the call binding."""
+from payment_result_guard import evaluate
+from payment_result_guard.core import decision
+
+
+def evaluate_kept(placed, target, today):
+    try:
+        return evaluate({
+            "schema_version": "0.1", "scenario": "payment_promise",
+            "context": {"object_id": target.invoice.id, "currency": target.invoice.currency,
+                        "amount_minor": target.outstanding_minor, "locale": target.customer.locale,
+                        "today": today.isoformat()},
+            "source": {"call_id": placed.call_id, "binding": "matched",
+                       "scope": placed.evidence_scope, "data_origin": "host_result"},
+            "claims": placed.structured_result,
+            "turns": [{"id": f"r0:a0:t{i}", "speaker": speaker, "text": text}
+                      for i, (speaker, text) in enumerate(placed.transcript)],
+        })
+    except Exception:
+        # Keep failed checks reviewable; never fall back to unguarded acceptance.
+        return decision(reason="VALIDATOR_UNAVAILABLE", origin="host_result")
