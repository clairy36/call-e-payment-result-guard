+test('POST uses actual Python check before advisory persistence', async () => {
+  const response = await POST(req());
+  expect(response.status).toBe(200);
+  expect(mocks.complete).toHaveBeenCalledWith('call_demo',expect.objectContaining({decision:'retry_now',recovered_cents:0,action_link:null}));
+  expect(mocks.complete.mock.calls[0][1].action_taken).toContain('Advisory');
+});
+
+test('negative evidence does not become a retry recommendation', async () => {
+  const call = structuredClone(fixtures.retry.call);
+  call.structuredResult.evidence = call.recipients[0].attempts[0].transcriptTurns[0].text = 'Do not retry my payment.';
+  mocks.fetch.mockResolvedValue(call);
+  await POST(req());
+  expect(mocks.complete.mock.calls[0][1]).toMatchObject({decision:'unknown',action_link:null,recovered_cents:0});
+  expect(mocks.complete.mock.calls[0][1].action_taken).toContain('CONTRADICTORY_EVIDENCE');
+  expect(mocks.insert).not.toHaveBeenCalled();
+});
+
+test.each(['canceled','completed','failed'])('local %s state ignores late callback', async status => {
+  mocks.getLog.mockReturnValue({...fixtures.retry.callLog,status});
+  await POST(req());
+  expect(mocks.complete).not.toHaveBeenCalled();
+  expect(mocks.insert).not.toHaveBeenCalled();
+});
+
+test('existing duplicate protection remains', async () => {
+  mocks.has.mockReturnValue(true);
+  await POST(req());
+  expect(mocks.fetch).not.toHaveBeenCalled();
+  expect(mocks.complete).not.toHaveBeenCalled();
+});
+
+test('missing transcript becomes review, never a new no-answer call', async () => {
+  const call = structuredClone(fixtures.retry.call); call.recipients[0].attempts[0].transcriptTurns=[];
+  mocks.fetch.mockResolvedValue(call); await POST(req());
